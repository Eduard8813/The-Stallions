{
  "expo": {
    "name": "Wani Connect",
    "slug": "the-stallions",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "thestallions",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/images/app-icon.png"
    },
    "android": {
      "package": "com.eduard8813steam.thestallions",
      "googleServicesFile": "./google-services.json",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/app-icon-foreground.png",
        "monochromeImage": "./assets/images/app-icon-monochrome.png",
        "backgroundColor": "#69B5E6"
      }
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#69B5E6",
          "image": "./assets/images/app-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permitir que Wani Connect acceda a tus fotos para cambiar tu foto de perfil.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir que $(PRODUCT_NAME) use tu ubicacion para mostrar rutas turisticas."
        }
      ],
      "expo-image",
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "color": "#6366F1"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "root": "src/app"
      },
      "eas": {
        "projectId": "c2e2a501-d62a-4609-9f62-c5366ddeacb3"
      }
    },
    "owner": "eduard8813s-team"
  }
}
